# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_PUBLIC_URL=https://api.herokidsuniverse.com

# ── Database & Cache (set by docker-compose env substitution) ─────────────────
# DATABASE_URL and REDIS_URL are overridden in docker-compose.prod.yml
DATABASE_URL=postgresql://hku:CHANGE_DB_PASSWORD@hku-postgres:5432/heroverse
REDIS_URL=redis://hku-redis:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=GENERATED_ACCESS_SECRET
JWT_REFRESH_SECRET=GENERATED_REFRESH_SECRET
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=heroverse-assets
R2_PUBLIC_URL=https://assets.heroversekids.com

# ── AI providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=PASTE_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPEN_AI_API_KEY=PASTE_OPENAI_KEY

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Video / Audio ─────────────────────────────────────────────────────────────
ENABLE_BACKGROUND_MUSIC=false
BACKGROUND_MUSIC_PATH=
BACKGROUND_MUSIC_VOLUME=0.12
NARRATION_VOLUME=1.0
